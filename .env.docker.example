# Copy to .env.docker (git-ignored) for a local container check; see "Local container check" in docs/deploy.md.
# The container joins the compose network, so it reaches Postgres/MinIO by service name (`db`, `minio`).
DATABASE_URL=postgres://plants:plants@db:5432/plants
BETTER_AUTH_SECRET=dev-only-secret-change-me-at-least-32-chars
BETTER_AUTH_URL=http://localhost:3000
APP_URL=http://localhost:3000
AI_MODE=mock
S3_ENDPOINT=http://minio:9000
# Browser-reachable MinIO URL (published port) so presigned photo URLs load on the host.
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_BUCKET=plants
S3_ACCESS_KEY=minio
S3_SECRET_KEY=minio-secret
# dev only: never reuse these keys in production
VAPID_PUBLIC_KEY=BHaR0MpyuOp_kRK24mT_Xcqwn40gvbrD7XPV1iNzoqrGz1xzfDXv08UvpFIG4j6D0T9u8RvS-Ux4puUTbkePQxc
VAPID_PRIVATE_KEY=BYo3G-ulOd0TWrQ4JXQjLpicGkx-90IjDCk1HREoErE
VAPID_SUBJECT=mailto:admin@example.com
CRON_SECRET=dev-cron-secret-change-me
